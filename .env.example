# DSPy 智能客服 Agent Demo

# LLM 配置 — 当前使用 DeepSeek
# DSPy 通过 litellm 调用，格式: provider/model_name
# DeepSeek 可选: deepseek/deepseek-chat, deepseek/deepseek-reasoner
DSPY_LM=deepseek/deepseek-chat

# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 服务配置
HOST=0.0.0.0
PORT=8000
